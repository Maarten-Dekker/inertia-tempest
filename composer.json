{
  "name": "maartendekker/inertia-tempest",
  "description": "The Tempest adapter for Inertia.js.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Inertia\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Inertia\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "mago:lint": "vendor/bin/mago lint",
    "mago:fix": "vendor/bin/mago lint --fix",
    "mago:fmt": "vendor/bin/mago fmt",
    "rector": "vendor/bin/rector process --no-ansi",
    "qa": [
      "@mago:fmt",
      "@rector",
      "@mago:lint",
      "@test"
    ]
  },
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "tempest/framework": "^3.0"
  },
  "conflict": {
    "guzzlehttp/psr7": "<2.0",
    "guzzlehttp/promises": "<2.0"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "carthage-software/mago": "1.8.0",
    "mockery/mockery": "^1.6.12",
    "phpunit/phpunit": "^12.5.11",
    "rector/rector": "2.3.6",
    "illuminate/pagination": "^13.0"
  },
  "suggest": {
    "illuminate/pagination": "Required to transform paginated data into a Laravel paginator instance.",
    "ext-pcntl": "Recommended when running the Inertia SSR server via the `inertia:start-ssr` tempest command."
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "carthage-software/mago": true
    }
  }
}
