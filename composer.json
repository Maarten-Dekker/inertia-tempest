{
  "name": "maartendekker/inertia-tempest",
  "description": "The Tempest adapter for Inertia.js.",
  "type": "library",
  "license": "MIT",
  "scripts": {
    "style": "composer fmt && composer lint:fix",
    "fmt": "vendor/bin/mago fmt",
    "lint": "vendor/bin/mago lint --potentially-unsafe --minimum-fail-level=note",
    "lint:fix": "vendor/bin/mago lint --fix --format-after-fix",
    "test": "vendor/bin/paratest",
    "test:full": "vendor/bin/phpunit -d memory_limit=2G --display-warnings --display-skipped --display-deprecations --display-errors --display-notices",
    "rector": "vendor/bin/rector process --no-ansi",
    "qa": [
      "composer rector",
      "composer fmt",
      "composer lint:fix",
      "composer lint",
      "composer test"
    ]
  },
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "tempest/framework": "^3.10"
  },
  "conflict": {
    "guzzlehttp/psr7": "<2.0",
    "guzzlehttp/promises": "<2.0"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "brianium/paratest": "^7.23.0",
    "carthage-software/mago": "1.45.0",
    "illuminate/pagination": "^13.0",
    "mockery/mockery": "^1.6.12",
    "phpunit/phpunit": "^13.2.2",
    "rector/rector": "2.5.8"
  },
  "suggest": {
    "illuminate/pagination": "Required to transform paginated data into a Laravel paginator instance.",
    "ext-pcntl": "Recommended when running the Inertia SSR server via the `inertia:start-ssr` tempest command."
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Inertia\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Inertia\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "carthage-software/mago": true
    }
  }
}
